            { name: "Thành viên 43", avatar: "" },
            { name: "Thành viên 44", avatar: "" },
            { name: "Thành viên 45", avatar: "" }
        ];

        // Tự động dựng thẻ card, nếu có link ảnh thì hiện ảnh, không thì hiện icon mặc định
        dsThanhVien.forEach((member, index) => {
            const card = document.createElement('div');
            card.className = 'member-card';
            
            let avatarContent = member.avatar 
                ? `<img src="${member.avatar}" alt="${member.name}">` 
                : `👤`;

            card.innerHTML = `
                <div class="member-avatar">${avatarContent}</div>
                <h3>${member.name}</h3>
                <div class="member-id">STT ${index + 1}</div>
            `;
            grid.appendChild(card);
        });
    </script>

</body>
</html>
